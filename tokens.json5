// ════════════════════════════════════════════════════════════════════
// Vivid Life Theme — Foundation Tokens
// ────────────────────────────────────────────────────────────────────
// This file is the SINGLE SOURCE OF TRUTH for the design system.
// Any downstream port (VS Code, Alacritty, GTK, web site, …) MUST
// read its colors / type / spacing / etc. from here. If a port needs
// a value not defined here, that's a foundation gap — open an issue
// against this file, not the port.
//
// Format: JSON5 (https://json5.org). Comments, trailing commas, and
// unquoted keys are allowed. Run `node tools/build-tokens.mjs` to emit
// `tokens.json` (strict JSON for tooling that can't parse JSON5).
//
// String values that begin with "$" are REFERENCES, resolved by the
// build script:  "$palette.red.500" → "#ef4444"
//
// Version 0.6.0 · August 2026
// ════════════════════════════════════════════════════════════════════
{
  meta: {
    name: "Vivid Life Theme",
    version: "0.6.0",
    description: "A multi-flavor color scheme system. 4 flavors × 6 variants = 24 themes.",
    source_palette: "https://farben.van-laar.de/",
    inspiration: ["https://catppuccin.com/", "https://draculatheme.com/"],
  },

  // ────────────────────────────────────────────────────────────────
  //   1.  PALETTE  —  the atomic colors
  // ────────────────────────────────────────────────────────────────
  // 7 hues × 6 shades, drawn from Tailwind v3 defaults.
  // The user's palette source calls them: Rot, Orange, Gelb, Grün,
  // Blau, Purpur, Grau. We use English everywhere downstream.
  //
  // The 800 tier was added for the light-flavor ANSI normal set (see
  // ansi_shade): on a light bg_terminal the 700 tier can't clear
  // 4.5:1, and 900 is already taken by the bright set — 800 is the
  // only rung that lets normal and bright stay distinct. It is a
  // Tailwind v3 default like every other shade here; adding it moved
  // no existing value. See issue #7.

  palette: {
    red: {
      900: "#7f1d1d",
      800: "#991b1b",
      700: "#b91c1c",
      500: "#ef4444",
      300: "#fca5a5",
      100: "#fee2e2",
    },
    orange: {
      900: "#7c2d12",
      800: "#9a3412",
      700: "#c2410c",
      500: "#f97316",
      300: "#fdba74",
      100: "#ffedd5",
    },
    yellow: {
      900: "#713f12",
      800: "#854d0e",
      700: "#a16207",
      500: "#eab308",
      300: "#fde047",
      100: "#fef9c3",
    },
    green: {
      900: "#365314",
      800: "#3f6212",
      700: "#4d7c0f",
      500: "#84cc16",
      300: "#bef264",
      100: "#ecfccb",
    },
    blue: {
      900: "#1e3a8a",
      800: "#1e40af",
      700: "#1d4ed8",
      500: "#3b82f6",
      300: "#93c5fd",
      100: "#dbeafe",
    },
    purple: {
      900: "#581c87",
      800: "#6b21a8",
      700: "#7e22ce",
      500: "#a855f7",
      300: "#d8b4fe",
      100: "#f3e8ff",
    },
    gray: {
      900: "#171717",
      800: "#262626",
      700: "#404040",
      500: "#737373",
      300: "#d4d4d4",
      100: "#f5f5f5",
    },

    // Extension hue — RESERVED for use cases where the protocol or
    // convention explicitly requires cyan (terminal ANSI cyan, git
    // diff hunk headers, etc.). NOT part of the variant axis. NOT in
    // the default syntax token map.
    cyan: {
      900: "#164e63",
      800: "#155e75",
      700: "#0e7490",
      500: "#06b6d4",
      300: "#67e8f9",
      100: "#cffafe",
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   2.  VARIANT HUES  —  the 6 hues exposed as accent variants
  // ────────────────────────────────────────────────────────────────
  // Cyan deliberately excluded. The order here is canonical and
  // matches the pinwheel wedge order in assets/logo.svg.

  variant_hues: ["red", "orange", "yellow", "green", "blue", "purple"],

  // ────────────────────────────────────────────────────────────────
  //   3.  ACCENT-SHADE RULESET  —  flavor × hue → shade index
  // ────────────────────────────────────────────────────────────────
  // Per the rule: "Pick the shade in the opposite half of the
  // lightness scale from the bg, one step in from the extreme
  // (300/700) by default. Step further only when the hue's intrinsic
  // luminance is too close to the background — and step by the
  // SMALLEST amount that clears: 800 before 900 on the dark side."
  //
  // 800 was added to the palette after this rule was first written, so
  // dawn's warm hues sat at 900 when 800 already cleared. That produced
  // a collision with semantic_shade (§ 3d), which also uses 900 on
  // dawn and noon: danger == accent on dawn-red, and so on. The rule
  // below the table makes that impossible to reintroduce.
  //
  // All 24 combinations clear WCAG 2.1 AA (≥ 4.5 : 1) against their
  // flavor background.

  accent_shade: {
    midnight: {
      red: 500,
      orange: 500,
      yellow: 500,
      green: 500,
      blue: 300,
      purple: 300,
    },
    twilight: {
      red: 300,
      orange: 300,
      yellow: 500,
      green: 500,
      blue: 300,
      purple: 300,
    },
    dawn: {
      red: 800,
      orange: 900,
      yellow: 800,
      green: 800,
      blue: 700,
      purple: 700,
    },
    noon: {
      red: 700,
      orange: 700,
      yellow: 800,
      green: 800,
      blue: 700,
      purple: 700,
    },
  },

  // INVARIANT (gated in tools/build-tokens.mjs): for every flavor, the
  // shade of semantic_shade.<flavor>.{danger,warning,success} must differ
  // from accent_shade.<flavor>.<hue of that role>. Otherwise a destructive
  // button is the same colour as a suggested one, and error text inside a
  // selection vanishes at 1.00:1. info is exempt: sharing the primary blue
  // is conventional and makes nothing unsafe (midnight-blue does this).

  // ────────────────────────────────────────────────────────────────
  //   3b. ANSI-SHADE RULESET  —  flavor × ansi hue → normal / bright
  // ────────────────────────────────────────────────────────────────
  // The terminal counterpart of accent_shade: the same "step out from
  // the background" rule, resolved against `surface.bg_terminal`
  // instead of `surface.bg`.
  //
  // Why this exists (issue #7). The 16-color ANSI palette used to be a
  // 2-set system inside a 4-flavor design system — one dark set shared
  // by Midnight and Twilight, one light set shared by Dawn and Noon.
  // Embedded ports hid that, because the editor canvas beside the
  // terminal panel carried the flavor identity. A standalone terminal
  // emulator has no editor pane: bg_terminal plus these 12 slots ARE
  // the whole theme, and Midnight/Twilight differed in 2 of 16 slots
  // (Dawn/Noon in 3, all of them neutrals). Each flavor now sits on
  // its own rung, which is also what frees bg_terminal to spread apart
  // — see the bg_terminal comments in each flavor below.
  //
  // ANSI hue names are NOT variant hues: ANSI has `magenta` and `cyan`,
  // the variant axis has `orange` and `purple`. ansi_hues maps the ANSI
  // slot name onto the palette hue it draws from. The four neutral
  // slots (black / white / bright_black / bright_white) are not shade-
  // driven and stay literal in each flavor's `ansi` block.
  //
  // tools/build-tokens.mjs verifies on every build that the resolved
  // flavors.*.ansi entries match this table, and that every ansi.*
  // color clears 4.5:1 against its flavor's bg_terminal — except the
  // slots listed in ansi_exempt.

  ansi_hues: {
    red: "red",
    green: "green",
    yellow: "yellow",
    blue: "blue",
    magenta: "purple",
    cyan: "cyan",
  },

  ansi_shade: {
    // Vivid 500 normals; 300 brights. blue/magenta used to sit at 300 in
    // both rows on the belief that their 500 rung couldn't clear a
    // near-black bg. Against #0a0a0a it does (5.38 / 5.00 : 1), and the
    // distinctness gate (§ 3g) caught the identical pair. Issue #19.
    midnight: {
      normal: {
        red: 500,
        green: 500,
        yellow: 500,
        blue: 500,
        magenta: 500,
        cyan: 500,
      },
      bright: {
        red: 300,
        green: 300,
        yellow: 300,
        blue: 300,
        magenta: 300,
        cyan: 300,
      },
    },
    // One rung lighter than Midnight in both rows: pastel normals, washed
    // brights. This is what makes Twilight legible as its own flavor in a
    // standalone emulator, and what lets bg_terminal rise to #333333.
    twilight: {
      normal: {
        red: 300,
        green: 300,
        yellow: 300,
        blue: 300,
        magenta: 300,
        cyan: 300,
      },
      bright: {
        red: 100,
        green: 100,
        yellow: 100,
        blue: 100,
        magenta: 100,
        cyan: 100,
      },
    },
    // 800 normals: the 700 rung can't clear 4.5:1 on a #d4d4d4 canvas, and
    // 900 is taken by the bright row. See palette § 800 tier.
    dawn: {
      normal: {
        red: 800,
        green: 800,
        yellow: 800,
        blue: 800,
        magenta: 800,
        cyan: 800,
      },
      bright: {
        red: 900,
        green: 900,
        yellow: 900,
        blue: 900,
        magenta: 900,
        cyan: 900,
      },
    },
    // Unchanged — the original light set.
    noon: {
      normal: {
        red: 700,
        green: 700,
        yellow: 700,
        blue: 700,
        magenta: 700,
        cyan: 700,
      },
      bright: {
        red: 900,
        green: 900,
        yellow: 900,
        blue: 900,
        magenta: 900,
        cyan: 900,
      },
    },
  },

  // Slots deliberately exempt from the 4.5:1-vs-bg_terminal gate: the
  // conventional reverse-video / "invisible" anchors that every real
  // terminal color scheme leaves at or near the background. Dark
  // flavors park `black` there; light flavors park `bright_white`
  // (and, on Dawn, `white`, which is exactly bg_terminal).

  ansi_exempt: {
    midnight: ["black"],
    twilight: ["black"],
    dawn: ["white", "bright_white"],
    noon: ["bright_white"],
  },

  // ────────────────────────────────────────────────────────────────
  //   3c. SYNTAX-SHADE RULESET  —  flavor × syntax slot → shade
  // ────────────────────────────────────────────────────────────────
  // The third instance of the accent_shade pattern (issue #9). The
  // README already states that the syntax hue map is intentionally
  // identical across flavors, so a file's "shape" reads the same in
  // Midnight and in Noon — that shared map is `syntax_hues`, and the
  // only thing a flavor contributes is which rung of each hue it
  // picks. Before this, all 48 values were hand-authored inside the
  // four flavor blocks; `flavors.*.syntax` is now derived.
  //
  // Slots that share a hue don't always share a rung — `string` vs
  // `attr` (both green) on every flavor, `number` vs `parameter` (both
  // orange) on Midnight — so the table is keyed by slot, not by hue,
  // exactly like ansi_shade. On the other three flavors the canvas only
  // affords one usable orange rung for both, and `parameter`'s italic
  // (syntax_tokens.extended) carries the split; see `distinct` (§ 3g).
  //
  // Every resolved slot must clear 4.5:1 on `bg` — code is body text,
  // so the 3:1 large-text threshold doesn't apply — and on every code
  // overlay in § 3e. tools/build-tokens.mjs gates both (issue #19).
  //
  // `comment` is the one slot that is not shade-driven: it maps to the
  // text-ramp alias `fg_subtle`, which is where comment grey has always
  // lived (two flavors sit on #a3a3a3 / #525252, deliberately outside
  // the palette — see the caveats in README). A slot whose hue is a
  // text alias must NOT appear in the shade rows below; a slot whose
  // hue is a palette hue must. tools/build-tokens.mjs gates that.

  syntax_hues: {
    comment: "fg_subtle", // text-ramp alias, not a palette hue
    keyword: "purple",
    string: "green",
    number: "orange",
    function: "blue",
    parameter: "orange",
    type: "yellow",
    constant: "orange",
    tag: "blue",
    attr: "green",
    regex: "red",
    punct: "gray",
  },

  syntax_shade: {
    midnight: {
      keyword: 300,
      string: 500,
      number: 500,
      function: 300,
      parameter: 300, // italic via extended map
      type: 500,
      constant: 500,
      tag: 300,
      attr: 300,
      regex: 300, // was 500 (4.76:1 on bg) — no headroom left for the overlays in § 3e (issue #19)
      punct: 300,
    },
    twilight: {
      keyword: 300,
      string: 500,
      number: 300,
      function: 300,
      parameter: 300, // was 500 (#f97316, 3.70:1 on bg — below 4.5). Now shares number's rung; the italic carries the split (§ 3g alias). Issue #19.
      type: 500,
      constant: 300,
      tag: 300,
      attr: 300,
      regex: 300,
      punct: 300,
    },
    // Dawn's #d4d4d4 canvas only affords the 800 / 900 rungs of the warm
    // hues, and those are all browns within ~6–8 ΔE of each other. Three
    // warm colours fit, not four: number/constant/parameter share
    // orange.800 (parameter is italic), regex goes to red.900, type stays
    // yellow.900. Issue #19.
    dawn: {
      keyword: 700,
      string: 900,
      number: 800, // was 700 (3.49:1 on bg)
      function: 700,
      parameter: 800, // was 900 — orange.900 vs type's yellow.900 is ΔE 4.6, the same brown
      type: 900,
      constant: 800, // was 700 (3.49:1 on bg)
      tag: 700,
      attr: 800, // was 700 (3.37:1 on bg)
      regex: 900, // was 700 (4.36:1 on bg); 800 sits within ΔE 6 of orange.800
      punct: 700,
    },
    // Noon could clear 4.5:1 at the 700 rung, but with 4.58:1 at worst it
    // left no room for any overlay to darken the canvas. One rung deeper
    // on four slots buys 5.93:1, which is what lets selection and find
    // tints in § 3e read as tints at all. Issue #19.
    noon: {
      keyword: 700,
      string: 900,
      number: 900, // was 700
      function: 700,
      parameter: 900,
      type: 800, // was 900 — keeps type ΔE ≥ 7 from number/parameter at orange.900
      constant: 900, // was 700
      tag: 700,
      attr: 800, // was 700
      regex: 700,
      punct: 700,
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   3d. SEMANTIC-SHADE RULESET  —  flavor × role → shade
  // ────────────────────────────────────────────────────────────────
  // Same shape, four roles. The hue per role is fixed by convention
  // (green = success, red = danger …) and never varies by flavor;
  // only the rung does. `flavors.*.semantic` is derived from this.
  //
  // Every resolved value must clear 4.5:1 against every surface tier
  // except bg_scrim and bg_inset — that gate already exists in
  // tools/build-tokens.mjs and is unchanged by this table.

  semantic_hues: {
    success: "green",
    warning: "yellow",
    danger: "red",
    info: "blue",
  },

  semantic_shade: {
    midnight: { success: 300, warning: 300, danger: 300, info: 300 },
    // Twilight's #404040 canvas needs a rung lighter than Midnight's
    // for three of the four; green.300 already clears it.
    twilight: { success: 300, warning: 100, danger: 100, info: 100 },
    dawn: { success: 900, warning: 900, danger: 900, info: 900 },
    noon: { success: 900, warning: 900, danger: 900, info: 900 },
  },

  // ────────────────────────────────────────────────────────────────
  //   3e.  OVERLAYS  —  everything that sits behind text
  // ────────────────────────────────────────────────────────────────
  // One recipe per (flavor, overlay): a colour target plus an alpha,
  // optionally a border. tools/build-tokens.mjs composites each recipe
  // over the flavor's `bg` and emits both halves into tokens.json as
  // `flavors.<flavor>.overlay.<variant>.<name>`:
  //
  //   { color: "#rrggbb", alpha: 0.5, flat: "#rrggbb", border?: "#rrggbb" }
  //
  // so a port with alpha support (VS Code, CSS) blends `color` at
  // `alpha`, a port without it (Windows Terminal, fish, PSReadLine) uses
  // `flat`, and both land on the same colour. Before issue #19 every
  // port carried its own alpha table — VS Code ten steps, Windows
  // Terminal a 30% selection while this file said 25% — and they had
  // drifted apart.
  //
  // Colour targets (shared with shell_roles / prompt_roles, § 15–16):
  //   accent                   the (flavor, variant) accent
  //   accent.<rung>            the variant's hue at another rung
  //   <hue>.<rung>             any palette entry, e.g. "cyan.900"
  //   fg | fg_muted | fg_subtle | fg_disabled
  //   semantic.<role>          success | warning | danger | info
  //
  // THE DIRECTION RULE. The gate below holds every syntax slot at 4.5:1
  // on every code overlay, and the dimmest slot (the comment grey on
  // dark flavors, the lightest saturated slot on light ones) leaves
  // almost no luminance to spend in the direction of the text. So:
  //
  //   dark flavors   tint with the 900 rung — a deep hue at or below the
  //                  canvas luminance, so light text keeps its contrast
  //   light flavors  tint with the 100 / 300 rung — a pale hue at or
  //                  above the canvas, the mirror image
  //
  // The old selection (25% of the *accent* over bg) did the opposite on
  // dark flavors: a light accent lightened the canvas toward the text.
  // On Midnight it dropped comments to 2.13:1 and on Twilight
  // `parameter` to 2.19:1.
  //
  // Hue families stay stable across flavors so the overlays read the
  // same way everywhere: selection and its weaker kin use the accent's
  // hue, find matches yellow, word highlights cyan (outside the variant
  // axis, so they never collide with the selection), diff green / red.
  // On the yellow variants the find match shares the selection's hue;
  // its border is what tells the two apart.

  overlay: {
    // What each overlay is for and what it is gated against.
    //   behind: "code"  every syntax slot, text.fg, text.fg_subtle and
    //                   the four semantic colours must clear 4.5:1 on the
    //                   flattened overlay, for all 6 variants
    //   behind: "ui"    only the roles listed in `text` are gated, on
    //                   every surface in `surfaces` (and `text_on_bg` on
    //                   the canvas only)
    // A recipe's `border` must clear 3:1 against `bg` (WCAG 1.4.11).
    roles: {
      selection: {
        behind: "code",
        use: "Text selection — editor, terminal, shell command line, ::selection.",
      },
      inactive_selection: {
        behind: "code",
        use: "Selection in an unfocused editor or terminal.",
      },
      line_highlight: { behind: "code", use: "The line the cursor is on." },
      find_match: { behind: "code", use: "The current search match." },
      find_match_other: { behind: "code", use: "Every other search match." },
      word_highlight_read: {
        behind: "code",
        use: "Other occurrences of the symbol under the cursor (read access).",
      },
      word_highlight_write: {
        behind: "code",
        use: "Occurrences of the symbol under the cursor that write to it.",
      },
      diff_inserted_line: {
        behind: "code",
        use: "Whole inserted line in a diff.",
      },
      diff_inserted_text: {
        behind: "code",
        use: "The changed characters within an inserted line.",
      },
      diff_inserted_gutter: {
        behind: "code",
        use: "Gutter / line-number column beside an inserted line.",
      },
      diff_removed_line: {
        behind: "code",
        use: "Whole removed line in a diff.",
      },
      diff_removed_text: {
        behind: "code",
        use: "The changed characters within a removed line.",
      },
      diff_removed_gutter: {
        behind: "code",
        use: "Gutter / line-number column beside a removed line.",
      },

      // The selected-item wash — the background of the one tab / row /
      // sidebar entry that is currently chosen (issue #14). Deliberately
      // subtle: at 18% it tops out at 1.21:1 against bg (midnight/red),
      // far below the 3:1 WCAG 1.4.11 asks of a standalone indicator, so
      // the underline / accent bar beside it stays load-bearing.
      //
      // It is a UI overlay, not a code one: a selected row's label is
      // `fg` by contract, so `fg` is what's gated — on every surface in
      // `surfaces`, because the tint is translucent and composites over
      // whatever the row lands on. On the canvas `fg_muted` must clear
      // too, and that is what pins 18%: Twilight sits at 4.81:1 there
      // and fails at 20% (4.63:1).
      //
      // `bg_inset` is deliberately absent. Twilight's #627084 sits at
      // 4.62:1 for `fg` before any tint at all, so no percentage clears
      // AA there. A port placing selected rows on `bg_inset` should
      // carry the accent bar plus a `state.hover` / `state.active`
      // overlay instead. `bg_scrim` is a modal backdrop.
      selected: {
        behind: "ui",
        use: "The selected tab / list row / sidebar entry. Reinforces an underline or accent bar; never the sole cue.",
        text: ["fg"],
        text_on_bg: ["fg_muted"],
        surfaces: ["bg", "bg_soft", "bg_sunk", "bg_overlay", "bg_terminal"],
      },
    },

    recipes: {
      // Midnight's budget is set by the comment grey (#999999): an
      // overlay may not rise much above #262626 in luminance.
      midnight: {
        selection: { color: "accent.900", alpha: 0.5 },
        inactive_selection: { color: "accent.900", alpha: 0.25 },
        line_highlight: { color: "gray.800", alpha: 1 },
        find_match: {
          color: "yellow.900",
          alpha: 0.5,
          border: "semantic.warning",
        },
        find_match_other: { color: "yellow.900", alpha: 0.25 },
        word_highlight_read: { color: "cyan.900", alpha: 0.25 },
        word_highlight_write: { color: "cyan.900", alpha: 0.5 },
        diff_inserted_line: { color: "green.900", alpha: 0.2 },
        diff_inserted_text: { color: "green.900", alpha: 0.45 },
        diff_inserted_gutter: { color: "green.900", alpha: 0.35 },
        diff_removed_line: { color: "red.900", alpha: 0.2 },
        diff_removed_text: { color: "red.900", alpha: 0.45 },
        diff_removed_gutter: { color: "red.900", alpha: 0.35 },
        selected: { color: "accent", alpha: 0.18 },
      },
      // Twilight's #404040 canvas sits above most 900 rungs, so its
      // overlays darken outright — a deep tint, not a light wash.
      twilight: {
        selection: { color: "accent.900", alpha: 0.75 },
        inactive_selection: { color: "accent.900", alpha: 0.4 },
        line_highlight: { color: "gray.800", alpha: 0.6 },
        find_match: {
          color: "yellow.900",
          alpha: 0.75,
          border: "semantic.warning",
        },
        find_match_other: { color: "yellow.900", alpha: 0.4 },
        word_highlight_read: { color: "cyan.900", alpha: 0.45 },
        word_highlight_write: { color: "cyan.900", alpha: 0.85 },
        diff_inserted_line: { color: "green.900", alpha: 0.4 },
        diff_inserted_text: { color: "green.900", alpha: 0.8 },
        diff_inserted_gutter: { color: "green.900", alpha: 0.6 },
        diff_removed_line: { color: "red.900", alpha: 0.4 },
        diff_removed_text: { color: "red.900", alpha: 0.8 },
        diff_removed_gutter: { color: "red.900", alpha: 0.6 },
        selected: { color: "accent", alpha: 0.18 },
      },
      // Dawn's syntax sits at 4.52:1 at worst (function, blue.700), so
      // nothing may darken the canvas at all. Every overlay lightens:
      // the 100 rung, which is above #d4d4d4 for every hue. 300 works
      // for yellow (the find match); it doesn't for the accent hues.
      dawn: {
        selection: { color: "accent.100", alpha: 1 },
        inactive_selection: { color: "accent.100", alpha: 0.5 },
        line_highlight: { color: "gray.100", alpha: 0.45 },
        find_match: {
          color: "yellow.300",
          alpha: 0.75,
          border: "semantic.warning",
        },
        find_match_other: { color: "yellow.300", alpha: 0.35 },
        word_highlight_read: { color: "cyan.100", alpha: 0.5 },
        word_highlight_write: { color: "cyan.100", alpha: 1 },
        diff_inserted_line: { color: "green.100", alpha: 0.5 },
        diff_inserted_text: { color: "green.100", alpha: 1 },
        diff_inserted_gutter: { color: "green.100", alpha: 0.8 },
        diff_removed_line: { color: "red.100", alpha: 0.5 },
        diff_removed_text: { color: "red.100", alpha: 1 },
        diff_removed_gutter: { color: "red.100", alpha: 0.8 },
        selected: { color: "accent", alpha: 0.18 },
      },
      // Noon's canvas is near white, so there is little room above it;
      // the deeper syntax rungs in § 3c buy room below instead, and the
      // 300 rung tints downward.
      noon: {
        selection: { color: "accent.300", alpha: 0.45 },
        inactive_selection: { color: "accent.300", alpha: 0.22 },
        line_highlight: { color: "gray.900", alpha: 0.05 },
        find_match: {
          color: "yellow.300",
          alpha: 0.8,
          border: "semantic.warning",
        },
        find_match_other: { color: "yellow.300", alpha: 0.35 },
        word_highlight_read: { color: "cyan.300", alpha: 0.3 },
        word_highlight_write: { color: "cyan.300", alpha: 0.6 },
        diff_inserted_line: { color: "green.300", alpha: 0.2 },
        diff_inserted_text: { color: "green.300", alpha: 0.45 },
        diff_inserted_gutter: { color: "green.300", alpha: 0.35 },
        diff_removed_line: { color: "red.300", alpha: 0.2 },
        diff_removed_text: { color: "red.300", alpha: 0.45 },
        diff_removed_gutter: { color: "red.300", alpha: 0.35 },
        selected: { color: "accent", alpha: 0.18 },
      },
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   3f.  CONTROL-BOUNDARY RULESET  —  the 3:1 outline for controls
  // ────────────────────────────────────────────────────────────────
  // WCAG 1.4.11 asks 3:1 for the visual information needed to identify
  // a UI component and its boundary. No pre-existing token pair could
  // deliver that on any flavor: a `bg_soft` control fill on a `bg`
  // canvas peaks at 1.73:1 (midnight) and bottoms out at 1.09:1
  // (noon), and `border.default` fails against every surface — three
  // of those combinations are literally invisible (identical hex).
  // Every toolkit port hit this independently and invented its own
  // workaround, which is exactly the divergence this repo exists to
  // prevent. See issue #15.
  //
  // The fix is a dedicated border weight, `border.control`, authored
  // per flavor below and gated here. The rule that picks it:
  //
  //   Take the grey CLOSEST to the surfaces it has to separate from
  //   — lighter on dark flavors, darker on light ones — that still
  //   clears 3:1 against every surface in `surfaces`, with a little
  //   headroom. All four land at ≈3.2:1 on their tightest surface.
  //
  // "Closest" is the whole point: the only existing token that already
  // cleared 3:1 everywhere was `text.fg_muted`, and a text-weight value
  // as a 1px control outline reads as a wireframe. This ruleset spends
  // the minimum contrast the criterion asks for and no more.
  //
  // Why a border and not a control fill: a fill that carries the
  // boundary on its own would have to be #646464 on midnight, #8a8a8a
  // on twilight, #777777 on dawn and #8e8e8e on noon — a mid-grey
  // button on a near-white canvas. That changes the visual language of
  // every flavor. The border keeps `bg_soft` as the control fill and
  // adds the one line the criterion actually needs.

  control_boundary: {
    // Minimum contrast a control boundary must clear, per WCAG 1.4.11.
    min: 3,

    // The surfaces controls actually sit on. tools/build-tokens.mjs
    // requires `border.control` to clear `min` against every one of
    // them, on every flavor.
    //
    // `bg_inset` is deliberately absent, the same exemption it already
    // carries from the semantic-vs-surface gate and from
    // overlay.roles.selected.surfaces. Clearing 3:1 on twilight's #627084
    // would need ≈#c9c9c9 — the text ramp, i.e. the wireframe outcome
    // this ruleset exists to avoid. A port drawing controls on docked
    // chrome should give them a `bg_soft` fill (which is on this list)
    // or rely on `state.hover` / `state.active`, not on a lighter
    // border. `bg_scrim` is a modal backdrop, not a control surface;
    // `bg_terminal` hosts no toolkit controls.
    surfaces: ["bg", "bg_soft", "bg_sunk", "bg_overlay"],
  },

  // ────────────────────────────────────────────────────────────────
  //   3g.  PERCEPTUAL CHECKS  —  distinctness gate + APCA report
  // ────────────────────────────────────────────────────────────────
  // Contrast against the background says nothing about whether two
  // foregrounds look alike. Auditing slot NAMES doesn't either: Dawn's
  // `parameter` (orange.900) and `type` (yellow.900) were different
  // slots on different hues and sat 4.6 apart in OKLab — the same brown.
  // So the gate audits RESOLVED colours (issue #19).
  //
  // Distance is Euclidean in OKLab, × 100 (so ≈ 2 is a just-noticeable
  // difference). tools/build-tokens.mjs checks, per flavor:
  //
  //   • every pair of syntax core slots plus `fg` ≥ `min`, except the
  //     pairs in `syntax.alias` (exempt) and `syntax.related` (≥
  //     `related_min`)
  //   • every pair within the normal ANSI row and within the bright
  //     row (neutrals included) ≥ `min`, except `ansi.exempt`
  //   • each ANSI colour vs its bright version ≥ `related_min`
  //
  // An alias is a pair that shares a colour ON PURPOSE. Listing it is
  // the point: an accidental collision anywhere else still fails.

  distinct: {
    min: 7,
    related_min: 5,
    syntax: {
      alias: [
        ["number", "constant"], // same rung on every flavor by design
        ["function", "tag"], // same rung on every flavor by design
        // Twilight, Dawn and Noon have one usable orange rung for both;
        // `parameter` is italic everywhere (syntax_tokens.extended).
        ["number", "parameter"],
        ["constant", "parameter"],
      ],
      // Same hue family, different rung — must be distinguishable, not
      // far apart.
      related: [
        ["string", "attr"], // both green
        ["comment", "punct"], // both grey
      ],
    },
    ansi: {
      // Twilight's bright row is the 100 rung of every hue (issue #7):
      // the only rung lighter than its 300 normals that still has a hue.
      // At 100, red / magenta / blue / cyan / white converge on near-white
      // and green meets yellow at 2.4. No palette rung fixes this without
      // giving up the Twilight / Midnight split #7 exists for, so these
      // pairs are a known, accepted weakness of that one row — listed
      // pair by pair so any NEW collision still fails.
      exempt: {
        twilight: [
          ["bright_red", "bright_blue"],
          ["bright_red", "bright_magenta"],
          ["bright_red", "bright_white"],
          ["bright_green", "bright_yellow"],
          ["bright_green", "bright_white"],
          ["bright_yellow", "bright_white"],
          ["bright_blue", "bright_magenta"],
          ["bright_blue", "bright_cyan"],
          ["bright_blue", "bright_white"],
          ["bright_magenta", "bright_cyan"],
          ["bright_magenta", "bright_white"],
          ["bright_cyan", "bright_white"],
        ],
      },
    },
  },

  // APCA (WCAG 3 draft) lightness contrast, printed by the build next
  // to the WCAG ratio for every gated pair. INFORMATIONAL — not a gate:
  // APCA is still a draft, and WCAG 2.x is what the 4.5:1 rule above
  // enforces. Targets are absolute Lc values.
  apca_targets: {
    body: 75, // fg on bg
    syntax: 60, // syntax slots on bg
    comment: 45, // comment / fg_subtle on bg
  },

  // ────────────────────────────────────────────────────────────────
  //   4.  FLAVORS  —  the 4 base themes
  // ────────────────────────────────────────────────────────────────
  // Each flavor defines:
  //   surface  — background layers (bg / inset / lifted / sunk / overlay / scrim)
  //   text     — foreground layers
  //   border   — border weights
  //   state    — interaction states (hover/active) as alpha overlays
  //   ansi     — full 16-color terminal ANSI palette
  //
  // `semantic` and `syntax` are NOT authored here — they are derived
  // from semantic_shade / syntax_shade above (§ 3c, 3d) and appear in
  // the emitted tokens.json between `state` and `ansi`.
  //
  // Overlays (selection, find match, the selected-item wash, diff
  // tints …) are absent from `state` too: they depend on the variant as
  // well as the flavor, so they live in `overlay` (§ 3e). The resolved
  // values appear in tokens.json as `flavors.*.overlay.<variant>`.

  flavors: {
    // ─── MIDNIGHT (deep dark, OLED-friendly) ───
    midnight: {
      label: "Midnight",
      type: "dark",
      surface: {
        bg: "$palette.gray.900", // #171717
        bg_inset: "#434f60", // docked structural chrome (sidebar/panel/terminal/status bar) — fixed cool-slate tint, NOT a variant/accent color; see README § surface hierarchy. Exempt from the semantic-vs-surface WCAG gate (banners render on bg/bg_soft, never on bg_inset).
        bg_soft: "$palette.gray.700", // lifted panels
        bg_sunk: "#0a0a0a", // slightly below canvas — outside strict palette
        bg_overlay: "$palette.gray.700", // floating menus, dropdowns
        bg_scrim: "#000000cc", // modal backdrop (80% black)
        bg_terminal: "$flavors.midnight.surface.bg_sunk", // darkest of the four; anchors the low end of the bg_terminal spread. Clears ≥4.5:1 vs every ansi.* color except ansi.black (reverse-video anchor, == this value). See issues #5, #7.
      },
      text: {
        fg: "$palette.gray.100",
        fg_muted: "$palette.gray.300",
        fg_subtle: "#999999", // was gray.500 (#737373, 3.78:1 on bg). 6.29:1, APCA Lc 46 — the comment colour, and the luminance ceiling every dark overlay in § 3e is solved against. Outside the strict palette: gray.500 is too dark, gray.300 is fg_muted. Issue #19.
        fg_disabled: "#525252",
      },
      border: {
        subtle: "$palette.gray.800",
        default: "$palette.gray.700",
        strong: "$palette.gray.500",
        control: "#8f8f8f", // control boundary — 3.21:1 vs bg_soft/bg_overlay (#404040), 5.54:1 vs bg. Dedicated literal: the palette has no rung between gray.500 (#737373, 2.19:1 on bg_soft — fails) and gray.300 (#d4d4d4, 6.99:1 — passes, but it is this flavor's fg_muted, i.e. the wireframe outcome). See § 3f, issue #15.
      },
      state: {
        hover: "#ffffff14", // 8% white overlay
        active: "#ffffff1f", // 12% white overlay
      },
      ansi: {
        black: "#0a0a0a",
        red: "$palette.red.500",
        green: "$palette.green.500",
        yellow: "$palette.yellow.500",
        blue: "$palette.blue.500", // was blue.300 — identical to bright_blue. 5.38:1 on bg_terminal. Issue #19.
        magenta: "$palette.purple.500", // was purple.300 — identical to bright_magenta. 5.00:1 on bg_terminal. Issue #19.
        cyan: "$palette.cyan.500",
        white: "$palette.gray.300",
        bright_black: "#878787", // was $palette.gray.700 (#404040) — that shade only cleared 1.9:1 against bg_sunk/bg_terminal; #878787 clears 5.5:1. Dedicated literal (not a palette ref) so it doesn't move borders/text that also reference gray.700. See issue #5.
        bright_red: "$palette.red.300",
        bright_green: "$palette.green.300",
        bright_yellow: "$palette.yellow.300",
        bright_blue: "$palette.blue.300",
        bright_magenta: "$palette.purple.300",
        bright_cyan: "$palette.cyan.300",
        bright_white: "$palette.gray.100",
      },
    },

    // ─── TWILIGHT (classic dark) ───
    twilight: {
      label: "Twilight",
      type: "dark",
      surface: {
        bg: "$palette.gray.700", // #404040
        bg_inset: "#627084", // docked structural chrome (sidebar/panel/terminal/status bar) — fixed cool-slate tint, NOT a variant/accent color; see README § surface hierarchy. Exempt from the semantic-vs-surface WCAG gate (banners render on bg/bg_soft, never on bg_inset).
        bg_soft: "#525252", // neutral-600; lifted
        bg_sunk: "$palette.gray.900", // deeper recess
        bg_overlay: "#525252",
        bg_scrim: "#000000bb",
        bg_terminal: "#333333", // was bg_sunk (#171717), only ΔL* 5.0 from Midnight's — indistinguishable in a standalone terminal emulator, which shows no other surface. #333333 is ΔL* 18.5 from Midnight, matching the editor-bg spread that already reads as flavor identity, while staying below bg (#404040) so the embedded terminal panel keeps its layer. Outside the strict palette, like bg_sunk on Midnight. See issue #7.
      },
      text: {
        fg: "$palette.gray.100",
        fg_muted: "$palette.gray.300",
        fg_subtle: "#b8b8b8", // was #a3a3a3 (4.11:1 on bg). 5.23:1, APCA Lc 54, still ΔE 8.7 from fg_muted. Issue #19.
        fg_disabled: "#737373",
      },
      border: {
        subtle: "#525252",
        default: "$palette.gray.900",
        strong: "#0a0a0a",
        control: "#a6a6a6", // control boundary — 3.21:1 vs bg_soft/bg_overlay (#525252), 4.26:1 vs bg. This flavor's existing borders all run DARKER than the canvas and none can reach 3:1 (border.strong #0a0a0a tops out at 2.53:1), so the boundary has to come from above. See § 3f, issue #15.
      },
      state: {
        hover: "#ffffff14",
        active: "#ffffff1f",
      },
      ansi: {
        black: "$palette.gray.900",
        red: "$palette.red.300",
        green: "$palette.green.300",
        yellow: "$palette.yellow.300",
        blue: "$palette.blue.300",
        magenta: "$palette.purple.300",
        cyan: "$palette.cyan.300",
        white: "$palette.gray.300",
        bright_black: "#a3a3a3", // was #878787 — that literal cleared 5.0:1 against the old bg_terminal (#171717) but only 3.5:1 against #333333. #a3a3a3 clears 5.0:1 (it was this flavor's fg_subtle until issue #19 lifted that to #b8b8b8). See issues #5, #7.
        bright_red: "$palette.red.100",
        bright_green: "$palette.green.100",
        bright_yellow: "$palette.yellow.100",
        bright_blue: "$palette.blue.100",
        bright_magenta: "$palette.purple.100",
        bright_cyan: "$palette.cyan.100",
        bright_white: "$palette.gray.100",
      },
    },

    // ─── DAWN (soft light) ───
    dawn: {
      label: "Dawn",
      type: "light",
      surface: {
        bg: "$palette.gray.300", // #d4d4d4
        bg_inset: "#788ba5", // docked structural chrome (sidebar/panel/terminal/status bar) — fixed cool-slate tint, NOT a variant/accent color; see README § surface hierarchy. Exempt from the semantic-vs-surface WCAG gate (banners render on bg/bg_soft, never on bg_inset).
        bg_soft: "$palette.gray.100", // lifted
        bg_sunk: "#bdbdbd", // outside strict palette
        bg_overlay: "$palette.gray.100",
        bg_scrim: "#17171788",
        bg_terminal: "$flavors.dawn.surface.bg", // was bg_soft (#f5f5f5), only ΔL* 3.5 from Noon's — indistinguishable in a standalone terminal emulator. Dropping to the flavor canvas (#d4d4d4) gives ΔL* 15.1 from Noon and inherits the accent-shade table's own contrast guarantee for free, since this IS the surface that table is verified against. Cost: in embedded ports the terminal panel no longer differs from the editor canvas by fill — the panel is read from its bg_inset chrome and border instead. See issue #7.
      },
      text: {
        fg: "$palette.gray.900",
        fg_muted: "$palette.gray.700",
        fg_subtle: "#525252",
        fg_disabled: "#737373",
      },
      border: {
        subtle: "#bdbdbd",
        default: "#a3a3a3",
        strong: "$palette.gray.700",
        control: "#636363", // control boundary — 3.20:1 vs bg_sunk (#bdbdbd), 4.05:1 vs bg, 5.51:1 vs bg_soft. border.strong (#404040) also clears the gate but is this flavor's fg_muted; #636363 is the lightest value that still passes. See § 3f, issue #15.
      },
      state: {
        hover: "#0000000d", // 5% black overlay
        active: "#00000014", // 8% black overlay
      },
      ansi: {
        black: "$palette.gray.900",
        red: "$palette.red.800",
        green: "$palette.green.800",
        yellow: "$palette.yellow.800",
        blue: "$palette.blue.800",
        magenta: "$palette.purple.800",
        cyan: "$palette.cyan.800",
        white: "$palette.gray.300", // == bg_terminal: the reverse-video anchor on this flavor
        bright_black: "#525252", // was #656565 — that literal cleared 5.3:1 against the old bg_terminal (#f5f5f5) but only 3.9:1 against #d4d4d4. #525252 clears 5.3:1 and is already this flavor's fg_subtle / comment value. See issues #5, #7.
        bright_red: "$palette.red.900",
        bright_green: "$palette.green.900",
        bright_yellow: "$palette.yellow.900",
        bright_blue: "$palette.blue.900",
        bright_magenta: "$palette.purple.900",
        bright_cyan: "$palette.cyan.900",
        bright_white: "$palette.gray.100",
      },
    },

    // ─── NOON (crisp light) ───
    noon: {
      label: "Noon",
      type: "light",
      surface: {
        bg: "$palette.gray.100", // #f5f5f5
        bg_inset: "#91a0b6", // docked structural chrome (sidebar/panel/terminal/status bar) — fixed cool-slate tint, NOT a variant/accent color; see README § surface hierarchy. Exempt from the semantic-vs-surface WCAG gate (banners render on bg/bg_soft, never on bg_inset).
        bg_soft: "#ffffff",
        bg_sunk: "$palette.gray.300",
        bg_overlay: "#ffffff",
        bg_scrim: "#17171788",
        bg_terminal: "$flavors.noon.surface.bg_soft", // verified ≥4.5:1 vs every ansi.* color except ansi.bright_white (intentional reverse-video anchor); bright_black already clears 4.7:1 unchanged. See issue #5
      },
      text: {
        fg: "$palette.gray.900",
        fg_muted: "$palette.gray.700",
        fg_subtle: "#525252",
        fg_disabled: "#737373",
      },
      border: {
        subtle: "#e5e5e5",
        default: "$palette.gray.300",
        strong: "$palette.gray.500",
        control: "$palette.gray.500", // control boundary — 3.20:1 vs bg_sunk (#d4d4d4), 4.35:1 vs bg. The rule lands exactly on gray.500, which this flavor already uses for border.strong; noon is the one flavor that needed no new value. Kept as its own token so ports read the boundary from `control` on all four. See § 3f, issue #15.
      },
      state: {
        hover: "#0000000d",
        active: "#00000014",
      },
      ansi: {
        black: "$palette.gray.900",
        red: "$palette.red.700",
        green: "$palette.green.700",
        yellow: "$palette.yellow.700",
        blue: "$palette.blue.700",
        magenta: "$palette.purple.700",
        cyan: "$palette.cyan.700",
        white: "$palette.gray.700",
        bright_black: "$palette.gray.500",
        bright_red: "$palette.red.900",
        bright_green: "$palette.green.900",
        bright_yellow: "$palette.yellow.900",
        bright_blue: "$palette.blue.900",
        bright_magenta: "$palette.purple.900",
        bright_cyan: "$palette.cyan.900",
        bright_white: "$palette.gray.300",
      },
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   5.  TYPOGRAPHY
  // ────────────────────────────────────────────────────────────────
  // Three families. Cascadia Code for monospace (user's pick).
  // IBM Plex Sans + Serif for everything else — they're free, ship
  // matched sans/serif/mono faces (and Plex Mono is the closest
  // free alt to Cascadia if anyone wants a fully unified port).

  typography: {
    // Atkinson Hyperlegible — designed by the Braille Institute for
    // readers with low vision. Aligns with the system's WCAG-first
    // posture: every variant is contrast-verified, every face is
    // engineered for distinguishability between similar glyphs.
    //
    // The family ships only Sans + Mono (no serif). We deliberately
    // do NOT pair a third-party serif: keeping the brand to one family
    // is more important than completeness.
    families: {
      sans: {
        primary: "Atkinson Hyperlegible Next",
        weights: [200, 300, 400, 500, 600, 700, 800],
        variable: true,
        stack: '"Atkinson Hyperlegible Next", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
        source: "https://www.brailleinstitute.org/freefont",
        license: "OFL-1.1",
        files: [
          "fonts/AtkinsonHyperlegibleNext-VariableFont_wght.ttf",
          "fonts/AtkinsonHyperlegibleNext-Italic-VariableFont_wght.ttf",
        ],
      },
      mono: {
        primary: "Atkinson Hyperlegible Mono",
        weights: [200, 300, 400, 500, 600, 700, 800],
        variable: true,
        stack: '"Atkinson Hyperlegible Mono", "Cascadia Code", "Cascadia Mono", ui-monospace, Menlo, Consolas, monospace',
        source: "https://www.brailleinstitute.org/freefont",
        license: "OFL-1.1",
        files: [
          "fonts/AtkinsonHyperlegibleMono-VariableFont_wght.ttf",
          "fonts/AtkinsonHyperlegibleMono-Italic-VariableFont_wght.ttf",
        ],
        notes: "Cascadia Code kept in the stack as a fallback — respects the user's personal coding-font preference where it's installed locally.",
        nerd_font_variant: {
          name: "Atkinson Hyperlegible Mono Nerd Font",
          source: "https://www.nerdfonts.com/font-downloads",
          notes: "Port-side asset, not bundled here. Terminal ports (Alacritty, Kitty, iTerm, …) should recommend this variant so icon-using prompts like Starship and Powerlevel10k render correctly. Not used by the design system itself.",
        },
      },
    },

    weights: {
      regular: 400,
      medium: 500,
      semibold: 600,
      bold: 700,
    },

    // Logical type styles. Each entry is consumable directly.
    // size_px is the design size at 1× zoom; clients may scale.
    scale: {
      display_xl: {
        family: "sans",
        size_px: 48,
        line_height: 1.1,
        weight: 700,
        tracking: "-0.02em",
      },
      display_lg: {
        family: "sans",
        size_px: 36,
        line_height: 1.15,
        weight: 700,
        tracking: "-0.02em",
      },
      display_md: {
        family: "sans",
        size_px: 28,
        line_height: 1.2,
        weight: 600,
        tracking: "-0.015em",
      },
      heading: {
        family: "sans",
        size_px: 20,
        line_height: 1.3,
        weight: 600,
        tracking: "-0.01em",
      },
      body: {
        family: "sans",
        size_px: 16,
        line_height: 1.5,
        weight: 400,
        tracking: "0",
      },
      body_sm: {
        family: "sans",
        size_px: 14,
        line_height: 1.5,
        weight: 400,
        tracking: "0",
      },
      caption: {
        family: "sans",
        size_px: 12,
        line_height: 1.4,
        weight: 500,
        tracking: "0.02em",
      },
      label: {
        family: "sans",
        size_px: 11,
        line_height: 1.3,
        weight: 600,
        tracking: "0.08em",
        text_transform: "uppercase",
      },
      blockquote: {
        family: "sans",
        size_px: 18,
        line_height: 1.6,
        weight: 400,
        tracking: "0",
        italic: true,
      },
      code: {
        family: "mono",
        size_px: 14,
        line_height: 1.5,
        weight: 400,
        tracking: "0",
      },
      code_sm: {
        family: "mono",
        size_px: 12,
        line_height: 1.45,
        weight: 400,
        tracking: "0",
      },
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   6.  SPACING  —  4px base scale
  // ────────────────────────────────────────────────────────────────
  // Keys are scale-step numbers; values are pixel strings.
  // Use these for padding, margin, gap. Skip 7, 9, 11 etc by design
  // (the scale should not grow linearly past a point).

  spacing: {
    px: "1px",
    0: "0",
    1: "4px",
    2: "8px",
    3: "12px",
    4: "16px",
    5: "20px",
    6: "24px",
    8: "32px",
    10: "40px",
    12: "48px",
    16: "64px",
    20: "80px",
    24: "96px",
  },

  // ────────────────────────────────────────────────────────────────
  //   7.  RADII
  // ────────────────────────────────────────────────────────────────

  radii: {
    none: "0",
    sm: "4px",
    md: "8px",
    lg: "12px",
    xl: "16px",
    pill: "9999px",
  },

  // ────────────────────────────────────────────────────────────────
  //   8.  ELEVATION / SHADOW
  // ────────────────────────────────────────────────────────────────
  // 3 levels. Same shadow values across flavors — they read fine on
  // both light & dark surfaces because the alpha is what carries.

  shadows: {
    sm: "0 1px 2px rgba(0,0,0,0.08)",
    md: "0 4px 12px rgba(0,0,0,0.12), 0 1px 3px rgba(0,0,0,0.06)",
    lg: "0 12px 32px rgba(0,0,0,0.18), 0 4px 8px rgba(0,0,0,0.08)",

    // Inset / focus-ring helpers
    focus_ring_width: "2px",
    focus_ring_offset: "2px",
  },

  // ────────────────────────────────────────────────────────────────
  //   9.  MOTION
  // ────────────────────────────────────────────────────────────────

  motion: {
    duration: {
      instant: "0ms",
      fast: "120ms",
      base: "200ms",
      slow: "320ms",
    },
    easing: {
      standard: "cubic-bezier(0.2, 0, 0, 1)",
      enter: "cubic-bezier(0, 0, 0.2, 1)",
      exit: "cubic-bezier(0.4, 0, 1, 1)",
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   10.  SYNTAX TOKEN MAP  —  logical → concrete
  // ────────────────────────────────────────────────────────────────
  // The 12 "core" tokens are defined directly on each flavor (see
  // flavors.*.syntax) and emit as `--syn-<name>` CSS variables.
  //
  // Extended tokens map a logical name to either:
  //   • a string shorthand — resolves to { color: <string> }
  //   • { color?, style? } — color target + optional font-style array
  //
  // `color` target vocabulary:
  //   • core slot name (comment, keyword, …, parameter, …, punct)
  //   • fg, fg_muted, fg_subtle, fg_disabled  (→ flavors.*.text.*)
  //   • semantic.success | .warning | .danger | .info  (→ flavors.*.semantic.*)
  //
  // `style` values: "italic" | "bold" | "underline"
  // A missing `color` means style-only (inherits host text color).
  //
  // Ports do their own resolution at build time; the foundation
  // ships this map as metadata.

  syntax_tokens: {
    core: [
      "comment",
      "keyword",
      "string",
      "number",
      "function",
      "parameter",
      "type",
      "constant",
      "tag",
      "attr",
      "regex",
      "punct",
    ],
    extended: {
      // ── Repurposed ────────────────────────────────────────────
      variable: "fg",
      parameter: { color: "parameter", style: ["italic"] },
      property: "fg", // obj.foo, css property — was → "tag"
      decorator: { color: "function", style: ["italic"] }, // @foo, #[attr] — meta layer

      // ── Unchanged ────────────────────────────────────────────
      operator: "keyword", // +, -, =, =>, |
      builtin: { color: "function", style: ["italic"] }, // print, len, console.log — "not yours"
      namespace: "type", // module / namespace paths
      macro: "function", // println!, vec!
      lifetime: "constant", // Rust 'a, 'static
      heading: { color: "keyword", style: ["bold"] }, // markdown # ## ### — structural anchor
      link: "tag", // markdown [text](url)
      selector: "tag", // css .foo, :root
      unit: "number", // css 16px, 200ms
      hex: "string", // css #fff, #abc123
      shebang: "comment", // #!/usr/bin/env bash

      // ── New ───────────────────────────────────────────────────
      lang_var: { color: "constant", style: ["italic"] }, // this/self/super — language-provided
      emphasis: { color: "type", style: ["italic"] }, // markup.italic + markdown/rst/asciidoc emphasis
      strong: { color: "number", style: ["bold"] }, // markup.bold + markdown/rst/asciidoc strong
      invalid: { color: "semantic.danger", style: ["italic", "underline"] },
      invalid_deprecated: { color: "fg", style: ["italic", "underline"] },
      doc_keyword: "keyword", // JSDoc @param, @returns, etc.
      doc_type: { color: "type", style: ["italic"] },
      doc_param: { color: "parameter", style: ["italic"] },
      event: "function", // named event/signal (onClick, onError) — treat like a function
      label: { color: "fg", style: ["italic"] }, // goto/break label — rare, mark as unusual
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   11.  SCOPE RECOMMENDATIONS  —  TextMate scope → logical slot
  // ────────────────────────────────────────────────────────────────
  // Per-slot lists of TextMate scopes that ports SHOULD map to that
  // slot when generating tokenColors rules. Optional — ports may extend
  // or override based on their target's grammar coverage.

  scope_recommendations: {
    // Per-slot TextMate scope lists. Ports SHOULD map these scopes to
    // the named slot when generating tokenColors rules. Lists are ordered
    // from most specific (prefer) to most general (fallback).
    // Use VS Code "Developer: Inspect Editor Tokens and Scopes" to
    // confirm the exact scope stack for any token before writing a rule.

    // ── Core tokens ───────────────────────────────────────────────────
    comment: ["comment", "comment.line", "comment.block"],
    keyword: [
      "keyword.control",
      "keyword.other",
      "storage.type",
      "storage.modifier",
    ],
    string: ["string", "string.quoted", "string.template"],
    number: [
      "constant.numeric",
      "constant.language", // true, false, null, undefined
    ],
    function: ["entity.name.function", "support.function"],
    parameter: ["variable.parameter"],
    type: [
      "entity.name.type",
      "entity.name.class",
      "support.class",
      "support.type",
    ],
    constant: [
      "constant.other",
      // NOTE: variable.other.constant.{js,ts,tsx} → fg; see fg_fallthrough_jsts
    ],
    tag: ["entity.name.tag"],
    attr: ["entity.other.attribute-name"],
    regex: ["string.regexp"],
    punct: ["punctuation"],

    // ── Extended tokens ───────────────────────────────────────────────
    variable: ["variable.other.readwrite", "variable.other"],
    property: [
      "variable.other.property",
      "variable.other.member",
      "support.type.property-name",
    ],
    decorator: [
      "entity.name.function.decorator",
      "meta.decorator entity.name.function",
      "punctuation.decorator",
    ],
    operator: ["keyword.operator"],
    builtin: [
      "support.function.builtin",
      "support.class.builtin",
      "support.variable.builtin",
    ],
    namespace: ["entity.name.namespace", "entity.name.module"],
    macro: ["entity.name.function.macro", "support.function.macro"],
    lifetime: ["storage.modifier.lifetime.rust", "entity.name.lifetime.rust"],
    heading: [
      "markup.heading",
      "entity.name.section",
      "punctuation.definition.heading",
    ],
    link: ["markup.underline.link", "string.other.link"],
    selector: [
      "entity.other.pseudo-class",
      "entity.other.pseudo-element",
      "meta.selector entity.other.attribute-name",
    ],
    unit: ["keyword.other.unit"],
    hex: ["constant.other.color", "constant.other.color.rgb-value.css"],
    shebang: ["comment.line.shebang"],
    emphasis: ["markup.italic"],
    strong: ["markup.bold"],
    invalid: ["invalid.illegal"],
    invalid_deprecated: ["invalid.deprecated"],
    event: ["variable.other.event", "support.type.event"],
    label: ["entity.name.label", "variable.label"],

    // ── Specific overrides ────────────────────────────────────────────
    // language-level pronouns (not function calls)
    lang_var: [
      "variable.language.this",
      "variable.language.self",
      "variable.language.super",
    ],

    // JSDoc / doc-comment children
    doc_keyword: ["comment.block.documentation keyword"],
    doc_type: ["comment.block.documentation entity.name.type"],
    doc_param: ["comment.block.documentation variable"],

    // In JS/TS, `const x = …` is the default declaration form and should
    // NOT inherit the `constant` color (that would color every const noisily).
    // Map these scopes to `fg`. The language-server `variable.readonly`
    // semantic token should still resolve to the `constant` slot.
    fg_fallthrough_jsts: [
      "variable.other.constant.js",
      "variable.other.constant.ts",
      "variable.other.constant.tsx",
    ],
  },

  // ────────────────────────────────────────────────────────────────
  //   12.  SEMANTIC TOKEN RECOMMENDATIONS
  //         VS Code LSP semantic token types → design system slots
  // ────────────────────────────────────────────────────────────────
  // Define semanticTokenColors entries alongside tokenColors.
  // When a semantic rule and a TextMate rule conflict, semantic wins.
  // Selector syntax: (tokenType)(.modifier)*(:language)?
  //   "variable"           all variables, any language
  //   "*.readonly"         all readonly tokens, any type
  //   "class:java"         classes in Java only
  //   "variable.readonly"  read-only variables, any language

  semantic_token_recommendations: {
    // ── 24 standard token types ───────────────────────────────────────
    // Color targets reference the same slot names as syntax_tokens.extended.
    // Ports resolve each slot to the per-flavor hex at build time.
    types: {
      namespace: "type",
      class: "type",
      enum: "type",
      interface: "type",
      struct: "type",
      typeParameter: "parameter", // generic <T> — orange; distinct from concrete type
      type: "type",
      parameter: { color: "parameter", style: ["italic"] },
      variable: "fg",
      property: "fg",
      enumMember: "constant",
      decorator: { color: "function", style: ["italic"] },
      event: "function",
      function: "function",
      method: "function",
      macro: "function",
      label: { color: "fg", style: ["italic"] },
      comment: { color: "comment", style: ["italic"] },
      string: "string",
      keyword: "keyword",
      number: "number",
      regexp: "regex",
      operator: "keyword",
    },

    // ── 11 semantic token modifiers ───────────────────────────────────
    // A modifier overrides ONLY the specified properties; all other
    // properties inherit from the base type mapping above.
    // Use selector "*.modifier" in semanticTokenColors for global rules.
    // "none" = no additional style beyond the base type.
    modifiers: {
      declaration: "none",
      definition: "none",
      readonly: { color: "constant" }, // treat as a named constant
      static: "none",
      deprecated: { style: ["italic", "underline"] },
      abstract: { style: ["italic"] }, // marks incomplete / virtual
      async: "none",
      modification: { color: "number" }, // orange — aligns with diff-modified
      documentation: { color: "comment" },
      defaultLibrary: { style: ["italic"] }, // "not yours"
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   13.  WORKBENCH COLOR ROLES  —  UI chrome / editor chrome
  // ────────────────────────────────────────────────────────────────
  // Maps design-system tokens to VS Code workbench color categories.
  // Use the SAME hue for each severity role everywhere it appears:
  // squiggles, gutter, overview ruler, status bar, minimap, panel.
  //
  // Background tints (selection, find match, diff …) are not here —
  // they live in `overlay` (§ 3e) and come out of the build already
  // resolved, as `flavors.<flavor>.overlay.<variant>.<name>`.

  workbench_color_roles: {
    // ── Signals (error / warning / info / success) ────────────────────
    signals: {
      error: "semantic.danger",
      warning: "semantic.warning",
      info: "semantic.info",
      hint: "semantic.info",
      success: "semantic.success",
    },

    // ── Git decorations ───────────────────────────────────────────────
    // Apply identically to: gitDecoration.*, editorGutter.*,
    // editorOverviewRuler.*, minimapGutter.*, diffEditor.*
    git: {
      added: "semantic.success",
      modified: "semantic.info",
      deleted: "semantic.danger",
      untracked: "semantic.success",
      ignored: "comment",
      conflicting: "semantic.warning",
    },

    // ── Diff editor ───────────────────────────────────────────────────
    // Diff backgrounds moved to `overlay` (§ 3e) in issue #19:
    // overlay.recipes.<flavor>.diff_{inserted,removed}_{line,text,gutter}.
    // Each is gated for every syntax slot at 4.5:1, which the old bare
    // alphas here (0.10 / 0.20 / 0.25 / 0.35 over bg) were not.

    // ── Bracket pair colorization ─────────────────────────────────────
    // Cycle these design-system slots in level order.
    // Resolve each slot to the per-flavor hex at port build time.
    bracket_pairs: ["fg", "regex", "number", "type", "string", "function"],
    bracket_unexpected: "semantic.danger",
  },

  // ────────────────────────────────────────────────────────────────
  //   14.  ICONOGRAPHY  —  what to use, per layer
  // ────────────────────────────────────────────────────────────────
  // Vivid Life Theme does NOT ship its own icon set. Building one for an
  // IDE + OS + apps would be ~5000 glyphs of work for a generation-
  // behind result. Instead we recommend best-in-class existing sets
  // per layer; ports document the recommendation and pull from CDN /
  // package manager. Every recommendation is monochrome / current-
  // color-able so it reflavors automatically with the theme.

  iconography: {
    // ── Layer C — INLINE UI GLYPHS  (buttons, menus, toolbars) ──
    // The only layer where Vivid Life Theme genuinely owns a visual choice.
    // Use stroke="currentColor" so the icon picks up its container's
    // foreground token — usually --vl-fg, --vl-fg-muted, or --vl-accent.
    inline_ui: {
      primary: {
        name: "Lucide",
        url: "https://lucide.dev/",
        license: "ISC",
        count: "approx 1500 unique glyphs",
        why: "Single-stroke style, forked from Feather specifically to fix small-size legibility. Used by shadcn/ui and most modern design systems. Coherence over coverage.",
        usage: 'Load from CDN, npm (`lucide`, `lucide-react`, `lucide-vue-next`, `lucide-svelte`), or pre-render specific SVGs at build time. All glyphs use stroke="currentColor" — set `color` in CSS to retint.',
      },
      alternative: {
        name: "Tabler Icons",
        url: "https://tabler.io/icons",
        license: "MIT",
        count: "approx 5800 unique glyphs",
        why: "Larger set if you need rarer glyphs (industry-specific, less common UI patterns). Slightly heavier visual weight; mixes outline + filled styles which becomes a per-icon design decision.",
      },
      not_recommended: {
        name: "Phosphor",
        why: "Quoted count (~9k) is 1512 unique glyphs × 6 weights. Smaller actual coverage than Lucide for typical UI needs; weight system is more complexity than the design system needs.",
      },
    },

    // ── Layer B — IDE FILE-TREE / FILETYPE ICONS ──
    // These encode file *type*. They are a visual language users learn
    // across apps. DO NOT recolor file icons with the Vivid Life Theme
    // accent — leave them as-is. Recolor only folder icons (where the
    // target supports it) and chrome.
    ide_filetree: {
      vscode: {
        recommended: "Material Icon Theme",
        url: "https://marketplace.visualstudio.com/items?itemName=PKief.material-icon-theme",
        alt: "Seti (VS Code default) — simpler, fewer file types covered",
        note: "Independent of the color theme. Users install it separately. Catppuccin and Dracula both leave file icons to the user; Vivid Life Theme does too.",
      },
      helix: {
        recommended: "Terminal-side via Nerd Font",
        note: "Helix shows file icons through the terminal emulator's font. Recommend Atkinson Hyperlegible Mono Nerd Font.",
      },
      neovim: {
        recommended: "nvim-web-devicons",
        url: "https://github.com/nvim-tree/nvim-web-devicons",
        note: "Uses the same Nerd Font glyph set; install Atkinson Hyperlegible Mono Nerd Font and pair.",
      },
      jetbrains: {
        recommended: "Built-in icons",
        note: "JetBrains IDEs do not allow user-configurable file icons. Accept the platform default.",
      },
    },

    // ── Layer A — OS / GTK / DESKTOP ──
    // Even larger problem (apps + mimetypes + actions + status icons).
    // Recommend Papirus universally; it already supports per-folder
    // accent recoloring via `papirus-folders`.
    desktop: {
      recommended: "Papirus",
      url: "https://github.com/PapirusDevelopmentTeam/papirus-icon-theme",
      license: "GPL-3.0",
      count: "approx 7000 icons",
      why: "Most popular community icon theme on Linux. Strong monochromatic-ish aesthetic that pairs with Vivid Life Theme without modification. Built-in `papirus-folders` CLI lets users tint folder accents to match their variant.",
      port_recipe: "GTK/Xfce ports should ship a small `papirus-folders` mapping recipe that picks a folder color matching each variant. No icons drawn.",
      alternatives: [
        "Numix Circle — older, more stylized, smaller community",
        "Sweet Icons — works well, smaller community than Papirus",
      ],
    },

    // ── What Vivid Life Theme ships in assets/glyphs/ ──
    // A tiny self-sufficient subset of Lucide for the design system's
    // own previews + future marketing site. Not a substitute for the
    // full set — apps pull Lucide from CDN/npm directly.
    bundled: {
      source: "Lucide v0.x — vendored subset",
      path: "assets/glyphs/",
      note: 'Each SVG uses stroke="currentColor". Container sets `color` to retint. See preview/16-iconography.html for the live spec.',
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   15.  SHELL ROLES  —  command-line highlighting (fish, PowerShell, …)
  // ────────────────────────────────────────────────────────────────
  // One entry per shell concept, so every shell port colours the same
  // command line the same way. Before issue #19 the fish and PowerShell
  // ports each mapped syntax slots to shell concepts in their own
  // template, and disagreed: an option flag was `attr` in fish and
  // `parameter` in PowerShell, a plain argument `parameter` in fish and
  // `fg` in PowerShell.
  //
  // Each role:
  //   color       foreground colour target (vocabulary in § 3e)
  //   background  background colour target — usually "overlay.<name>"
  //   style       any of "bold" | "italic" | "underline" | "reverse"
  //   fish        fish variables this role feeds
  //   psreadline  PSReadLine `-Colors` keys this role feeds
  //
  // A port iterates `roles` and writes every listed variable / key; a
  // shell that can't express part of a role (PSReadLine has no style
  // flags) drops that part. Shell text renders on `surface.bg_terminal`,
  // so "overlay.<name>" here resolves flattened over bg_terminal, and
  // tools/build-tokens.mjs gates every role's colour at 4.5:1 on its
  // background (or on bg_terminal when it has none), for all 24
  // (flavor, variant) combinations.
  //
  // Decisions where the ports disagreed:
  //   option   → attr.     `parameter` now shares `number`'s rung on
  //                         three flavors (§ 3c), so `-n 5` would read
  //                         as one colour.
  //   argument → fg.       Plain arguments are most of a command line;
  //                         tinting them all is noise.
  //   variable → constant. What PowerShell already shipped; fish has no
  //                         variable colour to set.
  //   selection            fg on overlay.selection in both — PSReadLine
  //                         replaces the span's colours outright, so it
  //                         needs the foreground; fish takes it too.

  shell_roles: {
    surface: "bg_terminal",
    roles: {
      default: {
        color: "fg",
        fish: ["fish_color_normal"],
        psreadline: ["Default"],
      },
      command: {
        color: "accent",
        fish: ["fish_color_command"],
        psreadline: ["Command"],
      },
      keyword: {
        color: "keyword",
        fish: ["fish_color_keyword"],
        psreadline: ["Keyword"],
      },
      option: {
        color: "attr",
        fish: ["fish_color_option"],
        psreadline: ["Parameter"],
      },
      argument: { color: "fg", fish: ["fish_color_param"], psreadline: [] },
      string: {
        color: "string",
        fish: ["fish_color_quote"],
        psreadline: ["String"],
      },
      number: { color: "number", fish: [], psreadline: ["Number"] },
      variable: { color: "constant", fish: [], psreadline: ["Variable"] },
      type: { color: "type", fish: [], psreadline: ["Type"] },
      member: { color: "function", fish: [], psreadline: ["Member"] },
      operator: {
        color: "keyword",
        fish: ["fish_color_operator"],
        psreadline: ["Operator"],
      },
      redirection: {
        color: "punct",
        fish: ["fish_color_redirection"],
        psreadline: [],
      },
      end: { color: "punct", fish: ["fish_color_end"], psreadline: [] },
      escape: {
        color: "constant",
        fish: ["fish_color_escape"],
        psreadline: [],
      },
      comment: {
        color: "comment",
        fish: ["fish_color_comment"],
        psreadline: ["Comment"],
      },
      autosuggestion: {
        color: "fg_subtle",
        fish: ["fish_color_autosuggestion"],
        psreadline: ["InlinePrediction"],
      },
      continuation: {
        color: "fg_subtle",
        fish: [],
        psreadline: ["ContinuationPrompt"],
      },
      error: {
        color: "semantic.danger",
        fish: ["fish_color_error"],
        psreadline: ["Error"],
      },
      cancel: {
        color: "semantic.danger",
        style: ["reverse"],
        fish: ["fish_color_cancel"],
        psreadline: [],
      },
      valid_path: {
        style: ["underline"],
        fish: ["fish_color_valid_path"],
        psreadline: [],
      },
      history_current: {
        style: ["bold"],
        fish: ["fish_color_history_current"],
        psreadline: [],
      },
      selection: {
        color: "fg",
        background: "overlay.selection",
        fish: ["fish_color_selection"],
        psreadline: ["Selection"],
      },
      // History-search hits. PSReadLine's `Emphasis` is the same idea.
      search_match: {
        color: "fg",
        background: "overlay.find_match",
        fish: ["fish_color_search_match"],
        psreadline: ["Emphasis"],
      },
      // The bracket / quote paired with the one under the cursor: an
      // occurrence related to the cursor, hence the word-highlight tint.
      // Was --background=semantic.info in fish, a solid fill nothing was
      // gated against.
      bracket_match: {
        color: "fg",
        background: "overlay.word_highlight_write",
        fish: ["fish_color_match"],
        psreadline: [],
      },

      // Completion pager / prediction list
      pager_prefix: {
        color: "accent",
        fish: ["fish_pager_color_prefix"],
        psreadline: [],
      },
      pager_completion: {
        color: "fg",
        fish: ["fish_pager_color_completion"],
        psreadline: ["ListPrediction"],
      },
      pager_description: {
        color: "fg_subtle",
        fish: ["fish_pager_color_description"],
        psreadline: [],
      },
      pager_progress: {
        color: "fg_subtle",
        fish: ["fish_pager_color_progress"],
        psreadline: [],
      },
      // The highlighted row: a selected list item, so the selected-item
      // wash rather than the text-selection tint (issue #14). Its text
      // follows the selected-row contract — labels at `fg` — because the
      // wash costs contrast: the accent prefix fell to 3.53:1 on it
      // (dawn/blue) and an fg_subtle description to 3.94:1 (dawn/red).
      // The prefix keeps its cue through bold + underline instead of hue.
      pager_selected: {
        background: "overlay.selected",
        fish: ["fish_pager_color_selected_background"],
        psreadline: [],
      },
      pager_selected_prefix: {
        color: "fg",
        style: ["bold", "underline"],
        background: "overlay.selected",
        fish: ["fish_pager_color_selected_prefix"],
        psreadline: [],
      },
      pager_selected_completion: {
        color: "fg",
        background: "overlay.selected",
        fish: ["fish_pager_color_selected_completion"],
        psreadline: ["ListPredictionSelected"],
      },
      pager_selected_description: {
        color: "fg_muted",
        background: "overlay.selected",
        fish: ["fish_pager_color_selected_description"],
        psreadline: [],
      },
    },
  },

  // ────────────────────────────────────────────────────────────────
  //   16.  PROMPT ROLES  —  Starship, Oh My Posh, Powerlevel10k, fish …
  // ────────────────────────────────────────────────────────────────
  // What colour each prompt segment takes. Before issue #19 the
  // Starship port decided this on its own — and differently in its own
  // two variants (git_branch purple in one, fg_muted in the other; the
  // success character `success` in one, `accent` in the other). A
  // second prompt port would have had to copy or re-invent it.
  //
  // Each role takes `color` / `style` as in § 15, plus:
  //   starship  "<module>.<field>" settings it feeds
  //   fish      fish variables it feeds (fish's default prompt reads
  //             fish_color_cwd, fish_color_user, …)
  //
  // The success character is `semantic.success`, not the accent: on the
  // red variants an accent-coloured ❯ would share a hue with the error
  // ❯. Git statuses follow workbench_color_roles.git (§ 13), so a file
  // reads the same in the prompt as in the editor's source-control view.
  //
  // `language_hues` gives each language / tool module a fixed hue, all
  // six variant hues used once, identical across all 24 themes so the
  // prompt's shape doesn't change with the variant. Resolve each as
  // "hue.<hue>" — the hue at its own accent rung on that flavor, which
  // the accent-shade table already guarantees at 4.5:1 on bg.

  prompt_roles: {
    surface: "bg_terminal",
    roles: {
      directory: {
        color: "accent",
        style: ["bold"],
        starship: ["directory.style"],
        fish: ["fish_color_cwd"],
      },
      directory_root: {
        color: "semantic.danger",
        style: ["bold"],
        starship: [],
        fish: ["fish_color_cwd_root"],
      },
      user: {
        color: "function",
        starship: ["username.style_user"],
        fish: ["fish_color_user"],
      },
      host: {
        color: "fg_muted",
        starship: ["hostname.style"],
        fish: ["fish_color_host"],
      },
      host_remote: {
        color: "semantic.warning",
        starship: [],
        fish: ["fish_color_host_remote"],
      },
      git_branch: {
        color: "fg_muted",
        starship: ["git_branch.style"],
        fish: [],
      },
      git_status: {
        color: "fg_muted",
        starship: ["git_status.style"],
        fish: [],
      },
      git_conflicted: {
        color: "semantic.warning",
        starship: ["git_status.conflicted"],
        fish: [],
      },
      git_ahead: {
        color: "fg_muted",
        starship: ["git_status.ahead"],
        fish: [],
      },
      git_behind: {
        color: "fg_muted",
        starship: ["git_status.behind"],
        fish: [],
      },
      git_diverged: {
        color: "fg_muted",
        starship: ["git_status.diverged"],
        fish: [],
      },
      git_untracked: {
        color: "semantic.success",
        starship: ["git_status.untracked"],
        fish: [],
      },
      git_stashed: {
        color: "fg_muted",
        starship: ["git_status.stashed"],
        fish: [],
      },
      git_modified: {
        color: "semantic.info",
        starship: ["git_status.modified"],
        fish: [],
      },
      git_staged: {
        color: "semantic.warning",
        starship: ["git_status.staged"],
        fish: [],
      },
      git_renamed: {
        color: "semantic.info",
        starship: ["git_status.renamed"],
        fish: [],
      },
      git_deleted: {
        color: "semantic.danger",
        starship: ["git_status.deleted"],
        fish: [],
      },
      character_success: {
        color: "semantic.success",
        starship: ["character.success_symbol"],
        fish: [],
      },
      character_error: {
        color: "semantic.danger",
        starship: ["character.error_symbol"],
        fish: ["fish_color_status"],
      },
      duration: {
        color: "semantic.warning",
        starship: ["cmd_duration.style"],
        fish: [],
      },
      time: { color: "fg_muted", starship: ["time.style"], fish: [] },
      fill: { color: "fg_muted", starship: ["fill.style"], fish: [] },
    },
    language_hues: {
      nodejs: "green",
      python: "yellow",
      rust: "orange",
      golang: "blue",
      java: "red",
      docker_context: "purple",
    },
  },
}
